### B-CBN
#################################################################################################################
#################################################################################################################
sink(file="./Codes/Others/Step4B.sh")
for (n in 5:10){
Subsets<-combn(10,n)
N.Subsets<-choose(10,n)
for (i in 1:N.Subsets){
cat(paste0("Rscript --vanilla ./Codes/Others/Step4B.R ",n," ",i,"\n"))
}
}
sink(file = NULL)
