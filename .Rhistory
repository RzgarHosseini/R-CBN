else if (N==X){
PathIndx<-0
for (i in 1:X){
PathIndx<-PathIndx+(PathN[i]*(10^(X-i)))
}
INDX<-which(PathsX==PathIndx)
Final<-PathProbsX[INDX]
return(Final)
}
else {print("The path length N must be either X or (X+1).")}
}
##################################################################################################################################################################
##################################################################################################################################################################
# R-CBN (Ensembl)
PathProb_Ensembl<-function(PathN,PathsX,PathProbsX){
#PathN: The path of length N, whose probability is needed to be computed.
#PathsX: All existing paths of length X (an m by X matrix)
#PathProbsX: The corresponding probability of the existing paths of length X (a numeric vector of length m)
N<-length(PathN)
X<-(N-1)
VEC<-1:N
pEstimate<-numeric(N)
for (i in 1:N){## N different options
NUM<-PathN[i]# The new number to be added
######## The backbone pathway probability
Bpath<-PathN[-i] #Bpath<-PathN[setdiff(1:N,i)]
BIndx<-as.numeric(paste0(Bpath,collapse=""))
pBINDX<-which(PathsX==BIndx)
# The Backbone pathway
Bprob<-PathProbsX[pBINDX]
######## The (N-1) emerging desired pathways of length N-1 ########
#Dprob<-0
WEC<-VEC[-i]
DIndx<-numeric((N-1))
count<-0
for (j in WEC){
# The j-th desired pathway
count<-count+1
Dpath<-PathN[-j]#Dpath<-PathN[setdiff(1:N,j)]
DIndx[count]<-as.numeric(paste0(Dpath,collapse=""))
#pDINDX[j]<-which(PathsX==DIndx)
#Dprob<-Dprob+PathProbsX[pDINDX]
}
pDINDX <- match(DIndx, PathsX, nomatch = 0)
Dprob<-sum(PathProbsX[pDINDX])
######## The (N-1)*(N-1) emerging competing pathways of length N-1 ########
## Checking the probability of each of the N-1 sub-pathways for each of the N (1 desired + (N-1) competing) pathways.
count<-0
CIndx<-numeric((N*(N-1)))
for (p in 1:N){
if (p==1){CpathN<-c(NUM,Bpath)}
else if (p==N){CpathN<-c(Bpath,NUM)}
else{CpathN<-c(Bpath[1:(p-1)],NUM,Bpath[p:(N-1)])}
YEC<-VEC[-p]
for (q in YEC){
count<-count+1
Cpath<-CpathN[-q] #Cpath<-CpathN[setdiff(1:N,q)]
CIndx[count]<-as.numeric(paste0(Cpath,collapse=""))
#pCINDX<-which(PathsX==CIndx)
#Cprob<-Cprob+PathProbsX[pCINDX]
}
}
pCINDX <- match(CIndx, PathsX, nomatch = 0)
Cprob<-sum(PathProbsX[pCINDX])
### The i-th probability estimate
if ((Bprob*Dprob)==0){pEstimate[i]<-0} else {pEstimate[i]<-((Dprob/Cprob)*Bprob)}
}
### The final probability estimate
Final<-mean(pEstimate)
return(Final)
}
##################################################################################################################################################################
##################################################################################################################################################################
# R-CBN (Ensembl)
PathProb_Ensembl_FAST<-function(PathN,PathsX,PathProbsX){
#PathN: The path of length N, whose probability is needed to be computed.
#PathsX: All existing paths of length X (an m by X matrix)
#PathProbsX: The corresponding probability of the existing paths of length X (a numeric vector of length m)
N<-length(PathN)
X<-(N-1)
VEC<-1:N
BIndx<-numeric(N)
DIndx<-list()
CIndx<-list()
for (i in 1:N){## N different options
NUM<-PathN[i]# The new number to be added
######## The backbone pathway probability
Bpath<-PathN[-i] #Bpath<-PathN[setdiff(1:N,i)]
BIndx[i]<-as.numeric(paste0(Bpath,collapse=""))
######## The (N-1) emerging desired pathways of length N-1 ########
#Dprob<-0
WEC<-VEC[-i]
DIndx[[i]]<-numeric((N-1))
count<-0
for (j in WEC){
# The j-th desired pathway
count<-count+1
Dpath<-PathN[-j]#Dpath<-PathN[setdiff(1:N,j)]
DIndx[[i]][count]<-as.numeric(paste0(Dpath,collapse=""))
}
######## The (N-1)*(N-1) emerging competing pathways of length N-1 ########
## Checking the probability of each of the N-1 sub-pathways for each of the N (1 desired + (N-1) competing) pathways.
count<-0
CIndx[[i]]<-numeric((N*(N-1)))
for (p in 1:N){
if (p==1){CpathN<-c(NUM,Bpath)}
else if (p==N){CpathN<-c(Bpath,NUM)}
else{CpathN<-c(Bpath[1:(p-1)],NUM,Bpath[p:(N-1)])}
YEC<-VEC[-p]
for (q in YEC){
count<-count+1
Cpath<-CpathN[-q] #Cpath<-CpathN[setdiff(1:N,q)]
CIndx[[i]][count]<-as.numeric(paste0(Cpath,collapse=""))
#pCINDX<-which(PathsX==CIndx)
#Cprob<-Cprob+PathProbsX[pCINDX]
}
}
}
pBINDX <- match(BIndx, PathsX, nomatch = 0)
pDINDXX<-c()
pCINDXX<-c()
for (i in 1:N){
pDINDXX<-c(pDINDXX,DIndx[[i]])
pCINDXX<-c(pCINDXX,CIndx[[i]])
}
pDINDX <- match(pDINDXX, PathsX, nomatch = 0)
pCINDX <- match(pCINDXX, PathsX, nomatch = 0)
pEstimate<-numeric(N)
for (i in 1:N){
dnum1<-(((N-1)*(i-1))+1)
dnum2<-((N-1)*i)
cnum1<-((N*(N-1)*(i-1))+1)
cnum2<-(N*(N-1)*i)
Bprob<-PathProbsX[pBINDX[i]]
Dprob<-sum(PathProbsX[pDINDX[dnum1:dnum2]])
Cprob<-sum(PathProbsX[pCINDX[cnum1:cnum2]])
### The i-th probability estimate
if ((Bprob*Dprob)==0){pEstimate[i]<-0} else {pEstimate[i]<-((Dprob/Cprob)*Bprob)}
}
### The final probability estimate
Final<-mean(pEstimate)
return(Final)
}
