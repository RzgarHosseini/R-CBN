Sample.Size<-dim(Geno10)[1]
sink(file="./Codes/Others/Step3.sh")
for (n in 5:10){
Subsets<-combn(10,n)
N.Subsets<-choose(10,n)
for (i in 1:N.Subsets){
cat(paste0("mkdir ./Data/Real_Data/Others/C/Genotype",n,"_",i,"\n"))
cat(paste0("echo '",n,"'>>./Data/Real_Data/Others/C/Genotype",n,"_",i,".poset\n"))
cat(paste0("echo '0'>>./Data/Real_Data/Others/C/Genotype",n,"_",i,".poset\n"))
cat(paste0("mkdir ./Data/Real_Data/Others/H/Genotype",n,"_",i,"\n"))
}
}
sink(file = NULL)
