matR5<-list()
Paths5<-PathEnumerator(10,5)
PathIndices4<-PathIndexer(10,4)
for (i in 7:7){
matR5[[i]]<-matrix(0,choose(10,5),factorial(5))
PathProbsR4<-PathProber(matR4[[i]],10,4)
for (j in 1:choose(10,5)){
for (k in 1:factorial(5)){
PATH5<-Paths5[[j]][k,]
matR5[[i]][j,k]<-PathProb_Ensembl_RCBN(PATH5,PathIndices4,PathProbsR4,4)
print(paste(5,i,j,k))
}
}
}
